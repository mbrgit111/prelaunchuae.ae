{
  "name": "prelaunchuae",
  "version": "0.1.0",
  "private": true,
  "description": "PrelaunchUAE (prelaunchuae.com): pre-launch and new-launch projects across the UAE, for MBR Properties. Copy of the Net Capital engine in the PrelaunchUAE brand; each domain is a folder under sites/.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-placeholders.ts --build && npm run -s pull:catalogue && npm run sync:images && node scripts/check-data.ts --build && node scripts/snapshot-content.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:data": "node scripts/check-data.ts",
    "check:placeholders": "node scripts/check-placeholders.ts",
    "sync:images": "node --network-family-autoselection-attempt-timeout=2000 scripts/sync-images.mjs",
    "fetch:data": "node scripts/fetch-remapp-all.mjs",
    "postbuild": "node scripts/check-budget.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "lighthouse": "sh scripts/lighthouse.sh",
    "check:seo": "node scripts/check-seo.mjs",
    "report:data": "node scripts/report-data.ts",
    "snapshot": "node scripts/snapshot-content.mjs",
    "test": "vitest run",
    "build:catalogue": "node scripts/build-catalogue.ts",
    "pull:catalogue": "node --network-family-autoselection-attempt-timeout=2000 scripts/pull-catalogue.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
