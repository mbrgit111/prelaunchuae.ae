# Which site this deployment serves (folder name under sites/)
NEXT_PUBLIC_SITE=prelaunchuae
# The MBR backend (lead desk, blog, catalogue). Built-in defaults: the live API in production builds, a local API
# (npm run dev:memory in mbr-lead-api, port 4000) while developing. Set these only to override.
# LEAD_API_URL=https://mbrbackend.wellnessz.in
# LEAD_SITE_KEY=pk_placeholder_netcapital
# true = show "[... FROM MBR]" markers where details are still missing (preview only)
PREVIEW_PLACEHOLDERS=true
# production = the build stops if any required contact detail is missing (set this in Vercel for the live site)
SITE_ENV=preview
# Shared secret the desk uses to ask this site to refresh a page right after a post is published. Set the same value in the desk.
# REVALIDATE_SECRET=
# Optional. Lets you open /api/content-status (with "Authorization: Bearer <this value>") to see whether the site is using
# the content API, the saved snapshot or the older article files right now. Without it that address does not exist.
# CONTENT_STATUS_TOKEN=

